---
import { getCollection } from 'astro:content';

const trainers = (await getCollection('trainer')).sort(
  (a, b) => a.data.reihenfolge - b.data.reihenfolge
);
---

<section id="trainer" class="section-padding bg-stone-50 dark:bg-primary relative overflow-hidden">
  <!-- Background texture -->
  <div class="absolute inset-0 opacity-[0.07] dark:opacity-5 pointer-events-none">
    <div class="absolute inset-0 dark:hidden" style="background-image: radial-gradient(circle at 1px 1px, #0B0B0F 1px, transparent 0); background-size: 40px 40px;"></div>
    <div class="absolute inset-0 hidden dark:block" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;"></div>
  </div>

  <div class="container-custom relative z-10">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 reveal">
      <div class="inline-flex items-center gap-3 mb-6">
        <div class="w-12 h-px bg-secondary"></div>
        <span class="text-secondary font-bold text-sm uppercase tracking-[0.3em]">Unser Team</span>
        <div class="w-12 h-px bg-secondary"></div>
      </div>
      <h2 class="heading-lg text-stone-900 dark:text-white mb-6">
        Die Coaches hinter <span class="text-secondary">deinem Training</span>
      </h2>
      <p class="text-stone-600 dark:text-gray-400 text-lg">
        Erfahrene, lizenzierte Trainer:innen begleiten dich auf jedem Niveau —
        von der ersten Trainingsstunde bis zum Wettkampf.
      </p>
    </div>

    {trainers.length === 0 ? (
      <!-- Empty State -->
      <div class="max-w-2xl mx-auto text-center reveal">
        <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-stone-100 dark:bg-gray-900 border border-stone-200 dark:border-gray-800 mb-8">
          <svg class="w-10 h-10 text-stone-400 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
        </div>
        <h3 class="text-stone-900 dark:text-white font-bold text-xl mb-3">
          Trainer-Profile folgen in Kürze
        </h3>
        <p class="text-stone-600 dark:text-gray-400 text-base">
          Unser Trainerteam lernst du direkt im Training vor Ort persönlich kennen.
          Lizenzierte Coaches mit Wettkampferfahrung — von Kinderboxen bis Stützpunkt&shy;training.
        </p>
        <a href="/kursplan" class="btn-primary mt-8 text-sm">
          Trainingszeiten ansehen
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>
    ) : (
    <!-- Trainer Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {trainers.map((trainer, index) => (
        <article
          class="group relative overflow-hidden bg-white dark:bg-gray-900 border border-stone-200 dark:border-gray-800 hover:border-secondary/60 shadow-sm dark:shadow-none hover:shadow-xl hover:shadow-secondary/10 transition-all duration-500 reveal"
          style={`transition-delay: ${index * 80}ms`}
        >
          <!-- Image / Placeholder -->
          <div class="relative aspect-[4/5] bg-stone-100 dark:bg-gray-800 overflow-hidden">
            {trainer.data.foto ? (
              <img
                src={trainer.data.foto}
                alt={`${trainer.data.name} — ${trainer.data.disziplin}`}
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
              />
            ) : (
              <div class="absolute inset-0 flex items-center justify-center">
                <!-- Silhouette placeholder -->
                <svg
                  class="w-32 h-32 text-stone-300 dark:text-gray-700 transition-colors duration-500 group-hover:text-secondary/40"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                </svg>
              </div>
            )}

            <!-- Disziplin Badge -->
            <div class="absolute top-4 left-4">
              <span class="px-3 py-1 bg-secondary text-white text-xs font-bold uppercase tracking-wider">
                {trainer.data.disziplin}
              </span>
            </div>

            <!-- Gradient overlay (only when image is present) -->
            {trainer.data.foto && (
              <div class="absolute inset-0 bg-gradient-to-t from-white/80 via-transparent to-transparent dark:from-gray-900 dark:via-gray-900/30"></div>
            )}
          </div>

          <!-- Content -->
          <div class="p-6">
            <h3 class="text-stone-900 dark:text-white font-bold text-xl mb-2 group-hover:text-secondary transition-colors duration-300">
              {trainer.data.name}
            </h3>
            {trainer.data.kurzbio && (
              <p class="text-stone-600 dark:text-gray-400 text-sm leading-relaxed">
                {trainer.data.kurzbio}
              </p>
            )}
          </div>

          <!-- Bottom accent -->
          <div class="absolute bottom-0 left-0 w-full h-1 bg-secondary transform scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left"></div>
        </article>
      ))}
    </div>

    <!-- Footer note -->
    <p class="text-center text-stone-500 dark:text-gray-500 text-sm mt-12 reveal">
      Vereinsmitglied und möchtest hier vorgestellt werden?
      <a href="/kontakt" class="text-secondary hover:underline">Schreib uns.</a>
    </p>
    )}
  </div>
</section>
