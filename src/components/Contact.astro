---
import { getEntry } from 'astro:content';
import StandortKarte from './StandortKarte.astro';

const site = (await getEntry('startseite', 'index'))?.data;
const cs = site?.contact_section ?? {
  kicker: 'Kontakt',
  headline_part1: 'Komm einfach',
  headline_part2_orange: 'vorbei.',
  intro: 'Keine Anmeldung nötig. Schau zu den Trainingszeiten vorbei, bring Sportzeug mit und mach mit. So einfach geht das.',
  form_titel: 'Direkt vorbeikommen',
  form_subtitel: 'Du brauchst keinen Termin und keine Anmeldung. Komm zu einem Training, das zu dir passt — wir freuen uns.',
};

const global = (await getEntry('global', 'site'))?.data;
const telefon = global?.telefon || '05371 7599679';
const telefonLink = global?.telefon_link || '+4953717599679';
const email = global?.email || 'info@boxclub-gifhorn.de';
const adresse = global?.adresse || 'Cardenap 2-4, 38518 Gifhorn';
const adresseHinweis = global?.adresse_hinweis || '';
const instagram = global?.instagram || '';
const instagramHandle = instagram ? '@' + instagram.replace(/\/+$/, '').split('/').pop() : '';
const whatsapp = global?.whatsapp || '';
const whatsappLink = global?.whatsapp_link || '';
const whatsappText = global?.whatsapp_text || '';
const whatsappHref = whatsappLink
  ? `https://wa.me/${whatsappLink}${whatsappText ? `?text=${encodeURIComponent(whatsappText)}` : ''}`
  : '';
---

<section id="kontakt" class="section-padding bg-white dark:bg-gray-900 relative overflow-hidden">
  <div class="absolute inset-0 opacity-[0.07] dark:opacity-5 pointer-events-none">
    <div class="absolute inset-0 dark:hidden" style="background-image: radial-gradient(circle at 1px 1px, #0B0B0F 1px, transparent 0); background-size: 50px 50px;"></div>
    <div class="absolute inset-0 hidden dark:block" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 50px 50px;"></div>
  </div>

  <div class="container-custom relative z-10">
    <div class="grid lg:grid-cols-2 gap-16">
      <!-- Left: Info -->
      <div class="reveal">
        <div class="inline-flex items-center gap-3 mb-6">
          <div class="w-12 h-px bg-secondary"></div>
          <span class="text-secondary font-bold text-sm uppercase tracking-[0.3em]">{cs.kicker}</span>
        </div>
        <h2 class="heading-lg text-stone-900 dark:text-white mb-6">
          {cs.headline_part1} <span class="text-secondary">{cs.headline_part2_orange}</span>
        </h2>
        <p class="text-stone-600 dark:text-gray-400 text-lg mb-10">
          {cs.intro}
        </p>

        <!-- Contact Cards -->
        <address class="not-italic">
        <div class="space-y-4">
          <a
            href={`tel:${telefonLink}`}
            class="flex items-center gap-4 p-6 bg-stone-50 dark:bg-primary border border-stone-200 dark:border-gray-800 hover:border-secondary/50 shadow-sm dark:shadow-none transition-all duration-300 group"
          >
            <div class="w-14 h-14 bg-secondary/10 border border-secondary/20 flex items-center justify-center group-hover:bg-secondary/20 transition-colors duration-300">
              <svg class="w-6 h-6 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <span class="text-stone-500 dark:text-gray-500 text-xs uppercase tracking-wider block mb-1">Telefon (Fragen beantworten wir gerne)</span>
              <span class="text-stone-900 dark:text-white font-bold text-lg">{telefon}</span>
            </div>
          </a>

          {whatsappHref && (
            <a
              href={whatsappHref}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-4 p-6 bg-stone-50 dark:bg-primary border border-stone-200 dark:border-gray-800 hover:border-[#25D366]/60 shadow-sm dark:shadow-none transition-all duration-300 group"
              aria-label="Boxclub Gifhorn per WhatsApp kontaktieren (öffnet WhatsApp)"
            >
              <div class="w-14 h-14 bg-[#25D366]/10 border border-[#25D366]/30 flex items-center justify-center group-hover:bg-[#25D366]/20 transition-colors duration-300">
                <svg class="w-6 h-6 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.488"/>
                </svg>
              </div>
              <div>
                <span class="text-stone-500 dark:text-gray-500 text-xs uppercase tracking-wider block mb-1">WhatsApp</span>
                <span class="text-stone-900 dark:text-white font-bold text-lg">{whatsapp}</span>
              </div>
            </a>
          )}

          <a
            href={`mailto:${email}`}
            class="flex items-center gap-4 p-6 bg-stone-50 dark:bg-primary border border-stone-200 dark:border-gray-800 hover:border-secondary/50 shadow-sm dark:shadow-none transition-all duration-300 group"
          >
            <div class="w-14 h-14 bg-secondary/10 border border-secondary/20 flex items-center justify-center group-hover:bg-secondary/20 transition-colors duration-300">
              <svg class="w-6 h-6 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <span class="text-stone-500 dark:text-gray-500 text-xs uppercase tracking-wider block mb-1">E-Mail</span>
              <span class="text-stone-900 dark:text-white font-bold text-lg">{email}</span>
            </div>
          </a>

          <div class="flex items-start gap-4 p-6 bg-stone-50 dark:bg-primary border border-stone-200 dark:border-gray-800 shadow-sm dark:shadow-none">
            <div class="w-14 h-14 flex-shrink-0 bg-accent/10 border border-accent/20 flex items-center justify-center">
              <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <span class="text-stone-500 dark:text-gray-500 text-xs uppercase tracking-wider block mb-1">Adresse</span>
              <span class="text-stone-900 dark:text-white font-bold text-lg block">{adresse}</span>
              {adresseHinweis && (
                <span class="text-stone-600 dark:text-gray-400 text-sm mt-1 block">{adresseHinweis}</span>
              )}
            </div>
          </div>

          {instagram && (
            <a
              href={instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-4 p-6 bg-stone-50 dark:bg-primary border border-stone-200 dark:border-gray-800 hover:border-secondary/50 shadow-sm dark:shadow-none transition-all duration-300 group"
              aria-label="Boxclub Gifhorn auf Instagram (öffnet in neuem Tab)"
            >
              <div class="w-14 h-14 bg-secondary/10 border border-secondary/20 flex items-center justify-center group-hover:bg-secondary/20 transition-colors duration-300">
                <svg class="w-6 h-6 text-secondary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4" />
                  <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                </svg>
              </div>
              <div>
                <span class="text-stone-500 dark:text-gray-500 text-xs uppercase tracking-wider block mb-1">Instagram</span>
                <span class="text-stone-900 dark:text-white font-bold text-lg">{instagramHandle}</span>
              </div>
            </a>
          )}
        </div>
        </address>
      </div>

      <!-- Right: Open-Doors-Hinweis + Karte -->
      <div class="reveal-right">
        <div class="bg-white dark:bg-primary border border-stone-200 dark:border-gray-800 shadow-lg dark:shadow-none p-8 lg:p-10">
          <div class="flex items-start gap-4 mb-4">
            <div class="w-12 h-12 flex-shrink-0 bg-secondary/10 border border-secondary/20 flex items-center justify-center">
              <svg class="w-6 h-6 text-secondary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </div>
            <div>
              <h3 class="text-stone-900 dark:text-white font-bold text-2xl mb-1 leading-tight">{cs.form_titel}</h3>
              <p class="text-stone-600 dark:text-gray-400 text-sm">{cs.form_subtitel}</p>
            </div>
          </div>

          <ul class="space-y-3 mb-6 text-stone-700 dark:text-gray-300 text-sm">
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-secondary flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span><strong class="text-stone-900 dark:text-white">Trainingszeiten checken</strong> — schau in den <a href="/kursplan" class="text-secondary hover:underline">Kursplan</a>, welcher Kurs zu dir passt.</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-secondary flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span><strong class="text-stone-900 dark:text-white">Sportzeug einpacken</strong> — Handschuhe & Bandagen leihen wir dir am Anfang.</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-secondary flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span><strong class="text-stone-900 dark:text-white">Vorbeikommen & mitmachen</strong> — keine Anmeldung, kein Druck.</span>
            </li>
          </ul>

          <div class="flex flex-wrap gap-3">
            <a href="/kursplan" class="btn-primary text-sm">
              Trainingszeiten ansehen
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </a>
            <a href={`tel:${telefonLink}`} class="btn-secondary text-sm">Anrufen</a>
            {whatsappHref && (
              <a
                href={whatsappHref}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-6 py-3 text-sm font-bold uppercase tracking-wider text-white bg-[#25D366] hover:bg-[#1ebe57] transition-colors"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.488"/>
                </svg>
                WhatsApp
              </a>
            )}
          </div>
        </div>

        <!-- Karte unter dem Open-Doors-Hinweis -->
        <div class="mt-6">
          <StandortKarte height="320px" compact />
        </div>
      </div>
    </div>
  </div>
</section>
