---
import { getEntry } from 'astro:content';

const site = (await getEntry('startseite', 'index'))?.data;
const hero = site?.hero;

const heroBildHaupt = hero?.bild || 'https://images.unsplash.com/photo-1620123449946-30d6efd4b8ba?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=1080';
const heroBildSeite = hero?.bild_seitlich || 'https://images.unsplash.com/photo-1734189605012-f03d97a4d98f?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=1080';

const farbeClass = (farbe: string) => farbe === 'gold' ? 'text-accent' : 'text-secondary';
---

<section class="relative min-h-[100vh] flex items-center overflow-hidden bg-primary">
  <!-- Background Image -->
  <div class="absolute inset-0">
    <img
      src={heroBildHaupt}
      alt="Boxtraining beim Boxclub Gifhorn — Sportler im Ring"
      class="w-full h-full object-cover"
      width="1920"
      height="1080"
      loading="eager"
      fetchpriority="high"
    />
    <!-- Dark Overlay -->
    <div class="absolute inset-0 bg-gradient-to-r from-primary via-primary/90 to-primary/50"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-primary via-transparent to-transparent"></div>
  </div>

  <!-- Decorative Elements -->
  <div class="absolute top-0 right-0 w-1/3 h-full bg-gradient-to-l from-secondary/10 to-transparent pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-secondary to-transparent"></div>
  <div class="absolute top-20 left-8 w-20 h-20 border-l-2 border-t-2 border-secondary/30 animate-pulse"></div>
  <div class="absolute bottom-20 right-8 w-20 h-20 border-r-2 border-b-2 border-accent/30 animate-pulse" style="animation-delay: 1s"></div>

  <!-- Content -->
  <div class="relative z-10 container-custom">
    <div class="grid lg:grid-cols-2 gap-12 items-center min-h-[80vh]">
      <!-- Left: Text -->
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-3 mb-8 animate-fade-in">
          <div class="w-12 h-px bg-secondary"></div>
          <span class="text-secondary font-bold text-sm uppercase tracking-[0.3em]">{hero?.badge}</span>
        </div>

        <h1 class="heading-xl text-white mb-6 animate-fade-in-up" style="animation-delay: 0.2s">
          <span class="sr-only">Boxclub Gifhorn e.V. — Boxen, MMA & Kampfsport in Gifhorn</span>
          {hero?.headline_zeile1}<br />
          <span class="text-secondary">{hero?.headline_zeile2_rot}</span><br />
          {hero?.headline_zeile3}<br />
          <span class="text-accent">{hero?.headline_zeile4_gold}</span>
        </h1>

        <p class="text-gray-300 text-lg md:text-xl leading-relaxed mb-10 max-w-xl animate-fade-in-up" style="animation-delay: 0.4s">
          {hero?.subheadline}
        </p>

        <div class="flex flex-wrap gap-4 animate-fade-in-up" style="animation-delay: 0.6s">
          <a href="/kontakt" class="btn-primary group">
            {hero?.cta_primary_label}
            <svg class="w-5 h-5 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
          <a href="/leistungen" class="btn-secondary">
            {hero?.cta_secondary_label}
          </a>
        </div>

        {hero?.stats && hero.stats.length > 0 && (
          <div class="mt-12 flex flex-wrap gap-8 animate-fade-in-up" style="animation-delay: 0.8s">
            {hero.stats.map((stat) => (
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 border border-gray-700 flex items-center justify-center">
                  <span class={`font-black text-lg ${farbeClass(stat.farbe)}`}>{stat.wert}</span>
                </div>
                <div>
                  <span class="text-white text-sm font-bold block">{stat.label_oben}</span>
                  <span class="text-gray-500 text-xs">{stat.label_unten}</span>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- Right: Visual -->
      <div class="hidden lg:flex items-center justify-center relative">
        <div class="relative w-full max-w-lg">
          <div class="absolute inset-0 bg-gradient-to-br from-secondary/20 via-transparent to-accent/20 rounded-full blur-3xl animate-pulse"></div>
          <div class="relative overflow-hidden" style="clip-path: polygon(10% 0%, 100% 0%, 90% 100%, 0% 100%);">
            <img
              src={heroBildSeite}
              alt="Kickbox- und Boxtraining im Boxclub Gifhorn"
              class="w-full h-[600px] object-cover"
              width="600"
              height="600"
              loading="eager"
              fetchpriority="high"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-primary via-transparent to-transparent"></div>
          </div>
          <div class="absolute -bottom-4 -left-4 bg-secondary px-6 py-3 animate-float">
            <span class="text-white font-black text-sm uppercase tracking-wider">Nr. 1 in Gifhorn</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 animate-fade-in" style="animation-delay: 1.2s">
    <span class="text-gray-500 text-xs uppercase tracking-widest">Scroll</span>
    <div class="w-px h-8 bg-gradient-to-b from-secondary to-transparent animate-pulse"></div>
  </div>
</section>
