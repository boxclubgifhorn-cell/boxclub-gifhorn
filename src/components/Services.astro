---
import { getCollection } from 'astro:content';

const services = (await getCollection('leistung'))
  .map((s) => ({
    title: s.data.title,
    tagline: s.data.tagline,
    description: s.data.description,
    image: s.data.bild || '',
    imageAlt: s.data.bild_alt || s.data.title,
    link: s.data.link || '/leistungen',
    reihenfolge: s.data.reihenfolge,
  }))
  .sort((a, b) => a.reihenfolge - b.reihenfolge);
---

<section id="leistungen" class="section-padding bg-stone-50 dark:bg-primary relative overflow-hidden">
  <!-- Background texture -->
  <div class="absolute inset-0 opacity-[0.07] dark:opacity-5">
    <div class="absolute inset-0 dark:hidden" style="background-image: radial-gradient(circle at 1px 1px, #0B0B0F 1px, transparent 0); background-size: 40px 40px;"></div>
    <div class="absolute inset-0 hidden dark:block" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;"></div>
  </div>

  <div class="container-custom relative z-10">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 reveal">
      <div class="inline-flex items-center gap-3 mb-6">
        <div class="w-12 h-px bg-secondary"></div>
        <span class="text-secondary font-bold text-sm uppercase tracking-[0.3em]">Unsere Leistungen</span>
        <div class="w-12 h-px bg-secondary"></div>
      </div>
      <h2 class="heading-lg text-stone-900 dark:text-white mb-6">
        Finde <span class="text-secondary">dein Training</span>
      </h2>
      <p class="text-stone-600 dark:text-gray-400 text-lg">
        Von Kinderboxen bis Profi-Wettkampf — wir bieten für jedes Level und jedes Alter das passende Programm.
      </p>
    </div>

    <!-- Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {services.map((service, index) => (
        <a
          href={service.link}
          class="group relative overflow-hidden bg-white dark:bg-gray-900 border border-stone-200 dark:border-gray-800 hover:border-secondary/50 shadow-sm dark:shadow-none hover:shadow-xl hover:shadow-secondary/10 transition-all duration-500 reveal block"
          style={`transition-delay: ${index * 80}ms`}
        >
          <!-- Image -->
          <div class="relative h-52 overflow-hidden bg-stone-100 dark:bg-gray-800">
            {service.image ? (
              <img
                src={service.image}
                alt={service.imageAlt}
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                loading="lazy"
              />
            ) : (
              <div class="w-full h-full flex items-center justify-center">
                <svg class="w-16 h-16 text-stone-300 dark:text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-white via-white/30 to-transparent dark:from-gray-900 dark:via-gray-900/40 dark:to-transparent"></div>

            <!-- Tagline badge -->
            <div class="absolute top-4 left-4">
              <span class="px-3 py-1 bg-secondary/90 text-white text-xs font-bold uppercase tracking-wider">
                {service.tagline}
              </span>
            </div>
          </div>

          <!-- Content -->
          <div class="p-6">
            <h3 class="text-stone-900 dark:text-white font-bold text-lg mb-3 group-hover:text-secondary transition-colors duration-300">
              {service.title}
            </h3>
            <p class="text-stone-600 dark:text-gray-400 text-sm leading-relaxed">
              {service.description}
            </p>

            <!-- Arrow link -->
            <div class="mt-4 flex items-center gap-2 text-secondary text-sm font-bold uppercase tracking-wider opacity-0 group-hover:opacity-100 transform translate-y-2 group-hover:translate-y-0 transition-all duration-300">
              <span>Zu allen Kursen in Gifhorn</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </div>
          </div>

          <!-- Hover border effect -->
          <div class="absolute bottom-0 left-0 w-full h-1 bg-secondary transform scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left"></div>
        </a>
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center mt-16 reveal">
      <a href="/leistungen" class="btn-primary group">
        Alle Kampfsport-Angebote in Gifhorn entdecken
        <svg class="w-5 h-5 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </div>
  </div>
</section>
