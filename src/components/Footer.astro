---
import { getEntry, getCollection } from 'astro:content';

const currentYear = new Date().getFullYear();

const global = (await getEntry('global', 'site'))?.data;
const firma = global?.firma_name || 'Boxclub Gifhorn e.V.';
const telefon = global?.telefon || '05371 7599679';
const telefonLink = global?.telefon_link || '+4953717599679';
const email = global?.email || 'info@boxclub-gifhorn.de';
const brandSubtitel = global?.brand_subtitel || 'Gifhorn e.V.';
const brandText = global?.footer_brand_text || '';
const instagram = global?.instagram || '';
const instagramHandle = instagram ? '@' + instagram.replace(/\/+$/, '').split('/').pop() : '';
const whatsapp = global?.whatsapp || '';
const whatsappLink = global?.whatsapp_link || '';
const whatsappText = global?.whatsapp_text || '';
const whatsappHref = whatsappLink
  ? `https://wa.me/${whatsappLink}${whatsappText ? `?text=${encodeURIComponent(whatsappText)}` : ''}`
  : '';

// Dynamische Services-Liste aus Leistungen-Collection
const services = (await getCollection('leistung'))
  .sort((a, b) => a.data.reihenfolge - b.data.reihenfolge)
  .slice(0, 7)
  .map((s) => s.data.title);

const mainLinks = [
  { label: 'Startseite', href: '/' },
  { label: 'Leistungen', href: '/leistungen' },
  { label: 'Kursplan', href: '/kursplan' },
  { label: 'Mitgliedsbeiträge', href: '/mitgliedsbeitraege' },
  { label: 'Trainer', href: '/#trainer' },
  { label: 'News', href: '/news' },
  { label: 'Galerie', href: '/galerie' },
  { label: 'Sponsoren', href: '/sponsoren' },
  { label: 'Anmeldung', href: '/anmeldung' },
  { label: 'Kontakt', href: '/kontakt' },
];

const legalLinks = [
  { label: 'Impressum', href: '/impressum' },
  { label: 'Datenschutz', href: '/datenschutz' },
  { label: 'Barrierefreiheit', href: '/barrierefreiheit' },
  { label: 'Satzung & Downloads', href: '/satzung' },
];

---

<footer class="bg-stone-100 dark:bg-primary border-t border-stone-200 dark:border-gray-800">
  <!-- Main Footer -->
  <div class="container-custom section-padding">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8">
      <!-- Brand -->
      <div class="lg:col-span-1">
        <a href="/" class="flex items-center gap-3 mb-6 group">
          <img
            src="/logo.png"
            alt="Boxclub Gifhorn e.V."
            width="48"
            height="48"
            class="w-12 h-12 rounded-full ring-1 ring-stone-300 dark:ring-white/10"
            loading="lazy"
          />
          <div class="flex flex-col">
            <span class="text-stone-900 dark:text-white font-black text-lg uppercase tracking-wider leading-none">{firma.split(' ')[0] || 'Boxclub'}</span>
            <span class="text-accent text-xs font-bold uppercase tracking-[0.3em] leading-none mt-0.5">{brandSubtitel}</span>
          </div>
        </a>
        <p class="text-stone-600 dark:text-gray-400 text-sm leading-relaxed mb-6">
          {brandText}
        </p>
        <div class="flex gap-4">
          <div class="w-2 h-2 bg-secondary rounded-full animate-pulse"></div>
          <span class="text-stone-500 dark:text-gray-500 text-xs uppercase tracking-wider">Trainiere mit den Besten</span>
        </div>
      </div>

      <!-- Navigation -->
      <div>
        <h3 class="text-stone-900 dark:text-white font-bold text-sm uppercase tracking-wider mb-6">Navigation</h3>
        <ul class="space-y-3">
          {mainLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-stone-600 dark:text-gray-400 hover:text-secondary text-sm transition-colors duration-300 flex items-center gap-2 group"
              >
                <span class="w-0 h-0.5 bg-secondary transition-all duration-300 group-hover:w-4"></span>
                {link.label}
              </a>
            </li>
          ))}
          {legalLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-stone-600 dark:text-gray-400 hover:text-secondary text-sm transition-colors duration-300 flex items-center gap-2 group"
              >
                <span class="w-0 h-0.5 bg-secondary transition-all duration-300 group-hover:w-4"></span>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Leistungen -->
      <div>
        <h3 class="text-stone-900 dark:text-white font-bold text-sm uppercase tracking-wider mb-6">Leistungen</h3>
        <ul class="space-y-3">
          {services.map((service) => (
            <li>
              <a
                href="/leistungen"
                class="text-stone-600 dark:text-gray-400 hover:text-accent text-sm transition-colors duration-300"
              >
                {service}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Kontakt -->
      <div>
        <h3 class="text-stone-900 dark:text-white font-bold text-sm uppercase tracking-wider mb-6">Kontakt</h3>
        <address class="not-italic">
        <ul class="space-y-4">
          <li>
            <a
              href={`tel:${telefonLink}`}
              class="flex items-center gap-3 text-stone-600 dark:text-gray-400 hover:text-secondary transition-colors duration-300 group"
            >
              <div class="w-10 h-10 border border-stone-300 dark:border-gray-700 group-hover:border-secondary flex items-center justify-center transition-colors duration-300">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <span class="text-xs text-stone-500 dark:text-gray-500 uppercase tracking-wider block">Telefon</span>
                <span class="text-sm">{telefon}</span>
              </div>
            </a>
          </li>
          <li>
            <a
              href={`mailto:${email}`}
              class="flex items-center gap-3 text-stone-600 dark:text-gray-400 hover:text-secondary transition-colors duration-300 group"
            >
              <div class="w-10 h-10 border border-stone-300 dark:border-gray-700 group-hover:border-secondary flex items-center justify-center transition-colors duration-300">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <span class="text-xs text-stone-500 dark:text-gray-500 uppercase tracking-wider block">E-Mail</span>
                <span class="text-sm">{email}</span>
              </div>
            </a>
          </li>
          {whatsappHref && (
            <li>
              <a
                href={whatsappHref}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-3 text-stone-600 dark:text-gray-400 hover:text-[#25D366] transition-colors duration-300 group"
                aria-label="Boxclub Gifhorn per WhatsApp kontaktieren (öffnet WhatsApp)"
              >
                <div class="w-10 h-10 border border-stone-300 dark:border-gray-700 group-hover:border-[#25D366] flex items-center justify-center transition-colors duration-300">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.488"/>
                  </svg>
                </div>
                <div>
                  <span class="text-xs text-stone-500 dark:text-gray-500 uppercase tracking-wider block">WhatsApp</span>
                  <span class="text-sm">{whatsapp}</span>
                </div>
              </a>
            </li>
          )}
          <li>
            <div class="flex items-center gap-3 text-stone-600 dark:text-gray-400">
              <div class="w-10 h-10 border border-stone-300 dark:border-gray-700 flex items-center justify-center">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <span class="text-xs text-stone-500 dark:text-gray-500 uppercase tracking-wider block">Standort</span>
                <span class="text-sm">Gifhorn</span>
              </div>
            </div>
          </li>
          {instagram && (
            <li>
              <a
                href={instagram}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-3 text-stone-600 dark:text-gray-400 hover:text-secondary transition-colors duration-300 group"
                aria-label="Boxclub Gifhorn auf Instagram (öffnet in neuem Tab)"
              >
                <div class="w-10 h-10 border border-stone-300 dark:border-gray-700 group-hover:border-secondary flex items-center justify-center transition-colors duration-300">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="5" />
                    <circle cx="12" cy="12" r="4" />
                    <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                  </svg>
                </div>
                <div>
                  <span class="text-xs text-stone-500 dark:text-gray-500 uppercase tracking-wider block">Instagram</span>
                  <span class="text-sm">{instagramHandle}</span>
                </div>
              </a>
            </li>
          )}
        </ul>
        </address>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-stone-200 dark:border-gray-800">
    <div class="container-custom py-6 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-stone-500 dark:text-gray-500 text-xs">
        &copy; {currentYear} {firma}. Alle Rechte vorbehalten.
      </p>
      <div class="flex items-center gap-6">
        {legalLinks.map((link) => (
          <a
            href={link.href}
            class="text-stone-500 dark:text-gray-500 hover:text-stone-900 dark:hover:text-gray-300 text-xs transition-colors duration-300"
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
