---
import { getEntry } from 'astro:content';

// Hauptnavigation im Header
const mainNav = [
  { label: 'Startseite',        href: '/' },
  { label: 'Leistungen',        href: '/leistungen', hasDropdown: true },
  { label: 'Kursplan',          href: '/kursplan' },
  { label: 'Mitgliedsbeiträge', href: '/mitgliedsbeitraege' },
  { label: 'Kontakt',           href: '/kontakt' },
];

// Zweites Menü (Burger rechts) — die übrigen Seiten, ohne Legal
const extraNav = [
  { label: 'Trainer',   href: '/#trainer' },
  { label: 'News',      href: '/news' },
  { label: 'Galerie',   href: '/galerie' },
  { label: 'Sponsoren', href: '/sponsoren' },
  { label: 'Anmeldung', href: '/anmeldung' },
];

// Slug-Helper für Anchor-IDs auf /leistungen (deutsche Umlaute → ascii)
// Muss exakt der gleichen Logik in src/pages/leistungen.astro folgen.
function slug(s: string): string {
  return s
    .toLowerCase()
    .replace(/ä/g, 'ae').replace(/ö/g, 'oe').replace(/ü/g, 'ue').replace(/ß/g, 'ss')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
}

// Leistungen für das Dropdown — Titles müssen 1:1 zu den Page-Titles in
// src/pages/leistungen.astro passen, damit Anchor-IDs treffen. Die
// Collection (src/content/leistung/) wird aktuell nur vom Footer
// genutzt; ein gemeinsamer Datenquell-Refactor kommt später.
const leistungenTitles = [
  'Kinder & Anfänger Training',
  'Boxen Kindertraining (5–8 Jahre)',
  'Judo für Kinder (6–12 Jahre)',
  'Boxen für Fortgeschrittene & Profis',
  'Profis & Stützpunkttraining',
  'MMA — Mixed Martial Arts (ab 16 Jahren)',
  'Ringen Training',
  'Frauenfitness (ab 14 Jahren)',
];
const leistungen = leistungenTitles.map((title) => ({ title, anchor: slug(title) }));

const global = (await getEntry('global', 'site'))?.data;
const firma = global?.firma_name || 'Boxclub Gifhorn e.V.';
const brandKurz = firma.split(' ')[0] || 'Boxclub';
const brandSubtitel = global?.brand_subtitel || 'Gifhorn e.V.';
const telefon = global?.telefon || '05371 7599679';
const telefonLink = global?.telefon_link || '+4953717599679';
const email = global?.email || 'info@boxclub-gifhorn.de';
---

<header id="main-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500">
  <div class="container-custom">
    <nav class="flex items-center justify-between h-20" aria-label="Hauptnavigation">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group flex-shrink-0" aria-label="Boxclub Gifhorn - Startseite">
        <img
          src="/logo.png"
          alt="Boxclub Gifhorn e.V. — Löwen-Logo"
          width="48"
          height="48"
          class="w-11 h-11 md:w-12 md:h-12 rounded-full ring-1 ring-stone-200 dark:ring-white/10 transform group-hover:scale-110 transition-transform duration-300"
          loading="eager"
        />
        <div class="flex flex-col">
          <span class="text-stone-900 dark:text-white font-black text-base xl:text-lg uppercase tracking-wider leading-none">{brandKurz}</span>
          <span class="hidden xl:block text-accent text-xs font-bold uppercase tracking-[0.3em] leading-none mt-0.5">{brandSubtitel}</span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-5 xl:gap-7">
        {mainNav.map((item) => (
          item.hasDropdown ? (
            <!-- Leistungen mit Dropdown -->
            <div class="relative group">
              <a
                href={item.href}
                class="inline-flex items-center gap-1 text-stone-700 dark:text-gray-300 hover:text-stone-900 dark:hover:text-white font-semibold text-sm uppercase tracking-wider transition-colors duration-300 relative"
                aria-haspopup="true"
              >
                {item.label}
                <svg class="w-3 h-3 transition-transform duration-300 group-hover:rotate-180 group-focus-within:rotate-180" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
                <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-secondary transition-all duration-300 group-hover:w-[calc(100%-1rem)]"></span>
              </a>
              <!-- Dropdown -->
              <div
                class="absolute top-full left-1/2 -translate-x-1/2 mt-3 w-72 opacity-0 invisible translate-y-2 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 group-focus-within:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 transition-all duration-200"
                role="menu"
              >
                <div class="bg-white dark:bg-primary border border-stone-200 dark:border-gray-800 shadow-2xl py-2">
                  {leistungen.map((l) => (
                    <a
                      href={`/leistungen#${l.anchor}`}
                      class="block px-5 py-2.5 text-sm font-semibold text-stone-700 dark:text-gray-300 hover:text-secondary hover:bg-stone-50 dark:hover:bg-gray-800/60 transition-colors"
                      role="menuitem"
                    >
                      {l.title}
                    </a>
                  ))}
                  <div class="border-t border-stone-200 dark:border-gray-800 mt-2 pt-1">
                    <a
                      href="/leistungen"
                      class="flex items-center justify-between px-5 py-2.5 text-xs uppercase tracking-wider font-bold text-secondary hover:bg-secondary/5 transition-colors"
                      role="menuitem"
                    >
                      <span>Alle Leistungen</span>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                      </svg>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class="text-stone-700 dark:text-gray-300 hover:text-stone-900 dark:hover:text-white font-semibold text-sm uppercase tracking-wider transition-colors duration-300 relative group"
            >
              {item.label}
              <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-secondary transition-all duration-300 group-hover:w-full"></span>
            </a>
          )
        ))}

        <!-- Dark Mode Toggle -->
        <button
          id="theme-toggle"
          class="p-2 text-stone-600 dark:text-gray-400 hover:text-stone-900 dark:hover:text-white transition-colors duration-300"
          aria-label="Farbmodus umschalten"
        >
          <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>

        <!-- CTA Button -->
        <a
          href="/anmeldung"
          class="px-6 py-3 bg-secondary hover:bg-secondary-600 text-white font-bold text-sm uppercase tracking-wider transition-all duration-300 hover:shadow-[0_0_25px_rgba(255,107,0,0.4)]"
        >
          Hier anmelden
        </a>

        <!-- Extra-Menü-Burger (Desktop) -->
        <button
          id="extra-menu-btn"
          class="p-2 text-stone-700 dark:text-gray-300 hover:text-secondary transition-colors duration-300"
          aria-label="Weitere Seiten"
          aria-expanded="false"
          aria-controls="extra-sheet"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

      <!-- Mobile Controls -->
      <div class="lg:hidden flex items-center gap-2">
        <button
          id="theme-toggle-mobile"
          class="p-2 text-stone-700 dark:text-gray-300 hover:text-stone-900 dark:hover:text-white transition-colors duration-300"
          aria-label="Farbmodus umschalten"
        >
          <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>
        <button
          id="mobile-menu-btn"
          class="p-2 text-stone-900 dark:text-white"
          aria-label="Menü öffnen"
          aria-expanded="false"
        >
          <div class="w-7 h-5 relative flex flex-col justify-between">
            <span class="hamburger-line w-full h-0.5 bg-stone-900 dark:bg-white transition-all duration-300 origin-left"></span>
            <span class="hamburger-line w-full h-0.5 bg-stone-900 dark:bg-white transition-all duration-300"></span>
            <span class="hamburger-line w-3/4 h-0.5 bg-secondary transition-all duration-300 origin-left"></span>
          </div>
        </button>
      </div>
    </nav>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="lg:hidden fixed inset-0 top-20 bg-white/98 dark:bg-primary/98 backdrop-blur-xl transform translate-x-full transition-transform duration-500 ease-out z-40 overflow-y-auto"
  >
    <div class="flex flex-col items-center justify-start min-h-full py-12 gap-6">
      <!-- Hauptnavigation -->
      {mainNav.map((item) => (
        <a
          href={item.href}
          class="text-stone-900 dark:text-white text-2xl font-black uppercase tracking-wider hover:text-secondary transition-colors duration-300"
        >
          {item.label}
        </a>
      ))}

      <!-- Leistungen-Sublist (kompakt) -->
      <div class="text-center max-w-xs">
        <p class="text-xs uppercase tracking-[0.3em] text-stone-500 dark:text-gray-500 font-bold mb-3">Disziplinen</p>
        <ul class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1.5 text-sm">
          {leistungen.map((l) => (
            <li>
              <a href={`/leistungen#${l.anchor}`} class="text-stone-700 dark:text-gray-400 hover:text-secondary transition-colors">
                {l.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Trennlinie -->
      <div class="w-16 h-px bg-stone-300 dark:bg-gray-700 my-2"></div>

      <!-- Extra-Navigation -->
      <div class="text-center">
        <p class="text-xs uppercase tracking-[0.3em] text-stone-500 dark:text-gray-500 font-bold mb-3">Weitere Bereiche</p>
        <ul class="flex flex-col gap-3">
          {extraNav.map((item) => (
            <li>
              <a href={item.href} class="text-stone-700 dark:text-gray-300 hover:text-secondary transition-colors text-lg font-bold uppercase tracking-wider">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Buttons + Kontakt -->
      <div class="mt-4 flex flex-col items-center gap-3">
        <a href="/anmeldung" class="btn-primary">Hier anmelden</a>
        <a href="/kursplan" class="btn-secondary text-sm">Trainingszeiten</a>
      </div>
      <div class="mt-4 flex flex-col items-center gap-2 text-stone-600 dark:text-gray-400 text-sm">
        <a href={`tel:${telefonLink}`} class="hover:text-secondary transition-colors">{telefon}</a>
        <a href={`mailto:${email}`} class="hover:text-secondary transition-colors">{email}</a>
      </div>
    </div>
  </div>
</header>

<!-- Spacer for fixed header -->
<div class="h-20"></div>

<!-- Extra-Sheet (Desktop-Burger) -->
<div
  id="extra-backdrop"
  class="fixed inset-0 bg-black/50 z-[55] opacity-0 invisible transition-opacity duration-300"
  aria-hidden="true"
></div>
<aside
  id="extra-sheet"
  class="fixed top-0 right-0 bottom-0 w-80 max-w-[90vw] bg-white dark:bg-primary z-[60] translate-x-full transition-transform duration-300 ease-out shadow-2xl flex flex-col"
  aria-label="Weitere Bereiche"
  aria-hidden="true"
>
  <div class="flex items-center justify-between px-6 py-5 border-b border-stone-200 dark:border-gray-800">
    <h2 class="text-stone-900 dark:text-white font-black uppercase tracking-wider text-sm">Weitere Bereiche</h2>
    <button
      id="extra-close"
      class="p-2 -mr-2 text-stone-500 hover:text-stone-900 dark:hover:text-white transition-colors"
      aria-label="Schließen"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
  <nav class="flex-1 overflow-y-auto py-3" aria-label="Weitere Navigation">
    <ul>
      {extraNav.map((item) => (
        <li>
          <a
            href={item.href}
            class="extra-sheet-link group flex items-center justify-between px-6 py-3.5 text-stone-700 dark:text-gray-300 hover:text-secondary hover:bg-stone-50 dark:hover:bg-gray-800/40 transition-colors"
          >
            <span class="font-bold text-sm uppercase tracking-wider">{item.label}</span>
            <svg class="w-4 h-4 opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-200" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <div class="px-6 py-4 border-t border-stone-200 dark:border-gray-800 text-stone-500 dark:text-gray-500 text-xs">
    <p class="uppercase tracking-wider font-bold mb-1">Direktkontakt</p>
    <a href={`tel:${telefonLink}`} class="block hover:text-secondary">{telefon}</a>
    <a href={`mailto:${email}`} class="block hover:text-secondary">{email}</a>
  </div>
</aside>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const header = document.getElementById('main-header');
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const themeToggle = document.getElementById('theme-toggle');
    const themeToggleMobile = document.getElementById('theme-toggle-mobile');
    const extraBtn = document.getElementById('extra-menu-btn');
    const extraSheet = document.getElementById('extra-sheet');
    const extraBackdrop = document.getElementById('extra-backdrop');
    const extraClose = document.getElementById('extra-close');

    // Sticky header background (light + dark sensitive)
    const scrolledClasses = [
      'bg-white/95', 'dark:bg-primary/95',
      'backdrop-blur-xl',
      'shadow-lg', 'dark:shadow-2xl', 'shadow-black/5', 'dark:shadow-black/20',
      'border-b', 'border-stone-200/60', 'dark:border-white/5',
    ];
    window.addEventListener('scroll', () => {
      const currentScroll = window.scrollY;
      if (header) {
        if (currentScroll > 50) {
          header.classList.add(...scrolledClasses);
        } else {
          header.classList.remove(...scrolledClasses);
        }
      }
    });

    // Mobile menu toggle
    let isMenuOpen = false;
    mobileMenuBtn?.addEventListener('click', () => {
      isMenuOpen = !isMenuOpen;
      if (mobileMenu) {
        mobileMenu.style.transform = isMenuOpen ? 'translateX(0)' : 'translateX(100%)';
      }
      mobileMenuBtn.setAttribute('aria-expanded', String(isMenuOpen));
      document.body.style.overflow = isMenuOpen ? 'hidden' : '';

      const lines = mobileMenuBtn.querySelectorAll('.hamburger-line');
      if (isMenuOpen) {
        (lines[0] as HTMLElement).style.transform = 'rotate(45deg) translateY(2px)';
        (lines[1] as HTMLElement).style.opacity = '0';
        (lines[2] as HTMLElement).style.transform = 'rotate(-45deg) translateY(-2px)';
        (lines[2] as HTMLElement).style.width = '100%';
      } else {
        (lines[0] as HTMLElement).style.transform = '';
        (lines[1] as HTMLElement).style.opacity = '1';
        (lines[2] as HTMLElement).style.transform = '';
        (lines[2] as HTMLElement).style.width = '75%';
      }
    });

    mobileMenu?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        isMenuOpen = false;
        if (mobileMenu) {
          mobileMenu.style.transform = 'translateX(100%)';
        }
        document.body.style.overflow = '';
        mobileMenuBtn?.setAttribute('aria-expanded', 'false');
        const lines = mobileMenuBtn?.querySelectorAll('.hamburger-line');
        if (lines) {
          (lines[0] as HTMLElement).style.transform = '';
          (lines[1] as HTMLElement).style.opacity = '1';
          (lines[2] as HTMLElement).style.transform = '';
          (lines[2] as HTMLElement).style.width = '75%';
        }
      });
    });

    // Extra-Sheet open/close
    const openExtra = () => {
      if (!extraSheet || !extraBackdrop) return;
      extraSheet.style.transform = 'translateX(0)';
      extraSheet.setAttribute('aria-hidden', 'false');
      extraBackdrop.style.opacity = '1';
      extraBackdrop.style.visibility = 'visible';
      extraBtn?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    };
    const closeExtra = () => {
      if (!extraSheet || !extraBackdrop) return;
      extraSheet.style.transform = '';
      extraSheet.setAttribute('aria-hidden', 'true');
      extraBackdrop.style.opacity = '';
      extraBackdrop.style.visibility = '';
      extraBtn?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    };
    extraBtn?.addEventListener('click', openExtra);
    extraClose?.addEventListener('click', closeExtra);
    extraBackdrop?.addEventListener('click', closeExtra);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeExtra();
    });
    // Close on link click inside sheet
    extraSheet?.querySelectorAll('a.extra-sheet-link').forEach((link) => {
      link.addEventListener('click', closeExtra);
    });

    // Theme toggle (Desktop + Mobile)
    const toggleTheme = () => {
      const isDark = document.documentElement.classList.toggle('dark');
      try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch (_) {}
    };
    themeToggle?.addEventListener('click', toggleTheme);
    themeToggleMobile?.addEventListener('click', toggleTheme);
  });
</script>
