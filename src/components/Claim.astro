---
import { getEntry } from 'astro:content';

const site = (await getEntry('startseite', 'index'))?.data;
const claim = site?.claim;

const kicker = claim?.kicker || '';
const headline = claim?.headline || '';
const text = claim?.text || '';

const hasContent = kicker || headline || text;
---

{hasContent && (
  <section class="relative bg-stone-900 dark:bg-black overflow-hidden">
    <!-- Hintergrund-Akzente -->
    <div class="absolute inset-0 opacity-[0.07] pointer-events-none">
      <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 50px 50px;"></div>
    </div>
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-secondary/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-accent/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="container-custom relative z-10 py-16 md:py-24">
      <div class="max-w-4xl mx-auto text-center reveal">
        {kicker && (
          <div class="inline-flex items-center gap-3 mb-6">
            <div class="w-12 h-px bg-secondary"></div>
            <span class="text-secondary font-bold text-sm md:text-base uppercase tracking-[0.3em]">{kicker}</span>
            <div class="w-12 h-px bg-secondary"></div>
          </div>
        )}

        {headline && (
          <h2 class="font-black uppercase tracking-tight text-white text-3xl md:text-5xl lg:text-6xl leading-[1.05] mb-8">
            <span class="text-secondary">{headline}</span>
          </h2>
        )}

        {text && (
          <p class="text-gray-300 text-lg md:text-xl leading-relaxed max-w-3xl mx-auto">
            {text}
          </p>
        )}
      </div>
    </div>
  </section>
)}
