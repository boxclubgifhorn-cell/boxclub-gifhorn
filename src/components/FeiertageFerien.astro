---
// -----------------------------------------------------------------------------
// Feiertage + Schulferien Niedersachsen — Daten werden zur Build-Zeit von der
// öffentlichen API https://openholidaysapi.org geladen (keine Tracking-Cookies,
// kein Runtime-Aufruf vom Browser des Besuchers).
// -----------------------------------------------------------------------------

type OHItem = {
  startDate: string;
  endDate: string;
  name: { language: string; text: string }[];
};

const jetzt = new Date();
const jahr = jetzt.getFullYear();
// Ab Oktober wird auch das Folgejahr mit angezeigt
const jahre: number[] = jetzt.getMonth() >= 9 ? [jahr, jahr + 1] : [jahr];

const BASE = 'https://openholidaysapi.org';
const SUB = 'DE-NI';
const LANG = 'DE';

async function fetchSafe(url: string): Promise<OHItem[]> {
  try {
    const r = await fetch(url, { headers: { Accept: 'application/json' } });
    if (!r.ok) return [];
    return (await r.json()) as OHItem[];
  } catch {
    return [];
  }
}

function nameDE(item: OHItem): string {
  return item.name.find((n) => n.language === LANG)?.text || item.name[0]?.text || '';
}

function fmtDate(iso: string): string {
  const [y, m, d] = iso.split('-');
  return `${d}.${m}.${y}`;
}

function fmtWeekday(iso: string): string {
  const wd = ['So', 'Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa'];
  return wd[new Date(iso + 'T00:00:00').getDay()];
}

function fmtZeitraum(start: string, end: string): string {
  if (start === end) return `${fmtWeekday(start)}, ${fmtDate(start)}`;
  return `${fmtWeekday(start)}, ${fmtDate(start)} – ${fmtWeekday(end)}, ${fmtDate(end)}`;
}

// Beide APIs parallel laden, pro Jahr
const ergebnisse = await Promise.all(
  jahre.map(async (j) => {
    const [feiertage, ferien] = await Promise.all([
      fetchSafe(
        `${BASE}/PublicHolidays?countryIsoCode=DE&languageIsoCode=${LANG}` +
          `&validFrom=${j}-01-01&validTo=${j}-12-31&subdivisionCode=${SUB}`,
      ),
      fetchSafe(
        `${BASE}/SchoolHolidays?countryIsoCode=DE&languageIsoCode=${LANG}` +
          `&validFrom=${j}-01-01&validTo=${j}-12-31&subdivisionCode=${SUB}`,
      ),
    ]);

    // Nur Einträge im aktuellen Jahr (Weihnachtsferien überlappen sonst)
    const inJahr = (it: OHItem) => it.startDate.startsWith(String(j)) || it.endDate.startsWith(String(j));
    feiertage.sort((a, b) => a.startDate.localeCompare(b.startDate));
    ferien.sort((a, b) => a.startDate.localeCompare(b.startDate));

    return {
      jahr: j,
      feiertage: feiertage.filter(inJahr),
      ferien: ferien.filter(inJahr),
    };
  }),
);

const hatDaten = ergebnisse.some((r) => r.feiertage.length || r.ferien.length);
---

<section class="section-padding bg-stone-50 dark:bg-primary">
  <div class="container-custom">
    <div class="max-w-5xl mx-auto reveal">
      <div class="inline-flex items-center gap-3 mb-4">
        <div class="w-12 h-px bg-secondary"></div>
        <span class="text-secondary font-bold text-sm uppercase tracking-[0.3em]">Trainings-Pausen</span>
      </div>
      <h2 class="heading-lg text-stone-900 dark:text-white mb-3">
        Feiertage & <span class="text-secondary">Schulferien</span>
      </h2>
      <p class="text-stone-600 dark:text-gray-400 max-w-2xl mb-10">
        Daten für Niedersachsen — an Feiertagen und in den Schulferien kann es zu
        Abweichungen vom regulären Trainingsplan kommen. Bitte achte auf Aushänge im
        Verein oder ruf vorher kurz an.
      </p>

      {hatDaten ? (
        <div class="space-y-10">
          {ergebnisse.map((r) => (
            <div>
              <h3 class="text-stone-900 dark:text-white font-display font-bold text-2xl mb-6">{r.jahr}</h3>

              <div class="grid md:grid-cols-2 gap-6">
                {/* Feiertage */}
                <div class="bg-white dark:bg-gray-900 border border-stone-200 dark:border-gray-800 overflow-hidden">
                  <div class="bg-stone-100 dark:bg-primary px-5 py-3 border-b-2 border-secondary">
                    <h4 class="text-stone-900 dark:text-white font-display font-bold uppercase tracking-wider text-sm">
                      Gesetzliche Feiertage
                    </h4>
                  </div>
                  {r.feiertage.length ? (
                    <table class="w-full text-sm">
                      <tbody>
                        {r.feiertage.map((it) => (
                          <tr class="border-b border-stone-200 dark:border-gray-800 last:border-0">
                            <td class="px-5 py-3 text-stone-900 dark:text-white font-semibold whitespace-nowrap w-1/2">
                              {nameDE(it)}
                            </td>
                            <td class="px-5 py-3 text-stone-600 dark:text-gray-400 whitespace-nowrap">
                              {fmtWeekday(it.startDate)}, {fmtDate(it.startDate)}
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  ) : (
                    <p class="px-5 py-4 text-sm text-stone-500 dark:text-gray-500">Aktuell keine Daten verfügbar.</p>
                  )}
                </div>

                {/* Schulferien */}
                <div class="bg-white dark:bg-gray-900 border border-stone-200 dark:border-gray-800 overflow-hidden">
                  <div class="bg-stone-100 dark:bg-primary px-5 py-3 border-b-2 border-accent">
                    <h4 class="text-stone-900 dark:text-white font-display font-bold uppercase tracking-wider text-sm">
                      Schulferien
                    </h4>
                  </div>
                  {r.ferien.length ? (
                    <table class="w-full text-sm">
                      <tbody>
                        {r.ferien.map((it) => (
                          <tr class="border-b border-stone-200 dark:border-gray-800 last:border-0">
                            <td class="px-5 py-3 text-stone-900 dark:text-white font-semibold align-top w-1/3">
                              {nameDE(it)}
                            </td>
                            <td class="px-5 py-3 text-stone-600 dark:text-gray-400">
                              {fmtZeitraum(it.startDate, it.endDate)}
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  ) : (
                    <p class="px-5 py-4 text-sm text-stone-500 dark:text-gray-500">Aktuell keine Daten verfügbar.</p>
                  )}
                </div>
              </div>
            </div>
          ))}

          <p class="text-xs text-stone-500 dark:text-gray-500 mt-6">
            Datenquelle:
            <a href="https://openholidaysapi.org/" target="_blank" rel="noopener noreferrer" class="hover:text-secondary underline">openholidaysapi.org</a>
            (Stand: Build-Zeitpunkt, wird bei jedem Site-Update aktualisiert).
          </p>
        </div>
      ) : (
        <p class="text-stone-600 dark:text-gray-400">
          Daten zu Feiertagen und Schulferien werden aktuell aktualisiert. Bitte versuche es
          später noch einmal oder ruf uns an: <a href="tel:+4953717599679" class="text-secondary hover:underline">05371 7599679</a>.
        </p>
      )}
    </div>
  </div>
</section>
