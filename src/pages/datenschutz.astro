---
import Layout from '../layouts/Layout.astro';
import LegalPage from '../components/LegalPage.astro';
import { getEntry } from 'astro:content';

const entry = await getEntry('seite', 'datenschutz');
const { Content } = await entry!.render();
const { title, intro, stand } = entry!.data;

const siteUrl = 'https://boxclub-gifhorn.de';
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Startseite', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Datenschutz', item: `${siteUrl}/datenschutz` },
  ],
};
---

<Layout
  title={`${title} | Boxclub Gifhorn e.V.`}
  description="Datenschutzerklärung des Boxclub Gifhorn e.V. — Informationen zum Umgang mit personenbezogenen Daten."
  noindex={true}
  jsonLd={breadcrumb}
>
  <LegalPage title={title} intro={intro} stand={stand} breadcrumb="Datenschutz">
    <Content />
  </LegalPage>
</Layout>
