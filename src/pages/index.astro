import Footer from '../components/Footer.astro';
---

<Layout
  title="Boxclub Gifhorn e.V. | Boxen, MMA, Judo & Fitness in Gifhorn"
  description="Nr. 1 Boxverein in Gifhorn seit über 50 Jahren. Boxen, MMA, Judo, Ringen und Frauenfitness für Kinder, Anfänger und Profis. Komm einfach zum Training vorbei — keine Anmeldung nötig."
>
  <Header />
  <main id="main-content">
    <Hero />
    <NewsHighlight />
    <Claim />
    <Services />
    <Benefits />
    <Trainers />
    <FAQ />
    <CTA />
    <Contact />
  </main>
  <Footer />
</Layout>
