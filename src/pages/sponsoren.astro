---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTA from '../components/CTA.astro';
import { getCollection } from 'astro:content';

const sponsoren = (await getCollection('sponsor'))
  .sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);

const grouped = sponsoren.reduce((acc, s) => {
  const key = s.data.kategorie || 'Unterstützer';
  if (!acc[key]) acc[key] = [];
  acc[key].push(s);
  return acc;
}, {} as Record<string, typeof sponsoren>);
const groupNames = Object.keys(grouped);

const siteUrl = 'https://boxclub-gifhorn.de';
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Startseite', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Sponsoren', item: `${siteUrl}/sponsoren` },
  ],
};
---

<Layout
  title="Sponsoren & Förderer in Gifhorn | Boxclub Gifhorn e.V."
  description="Diese Sponsoren und Partner unterstützen den Boxclub Gifhorn e.V. und unsere Nachwuchsförderung in Gifhorn — herzlichen Dank!"
  jsonLd={breadcrumb}
>
  <Header />
  <main id="main-content">
    <!-- Page Hero -->
    <section class="relative py-24 md:py-32 bg-stone-50 dark:bg-primary overflow-hidden">
      <div class="absolute inset-0 opacity-[0.07] dark:opacity-5 pointer-events-none">
        <div class="absolute inset-0 dark:hidden" style="background-image: radial-gradient(circle at 1px 1px, #0B0B0F 1px, transparent 0); background-size: 40px 40px;"></div>
        <div class="absolute inset-0 hidden dark:block" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;"></div>
      </div>

      <div class="container-custom relative z-10">
        <nav class="mb-8" aria-label="Breadcrumb">
          <ol class="flex items-center gap-2 text-sm text-stone-500 dark:text-gray-500">
            <li><a href="/" class="hover:text-secondary transition-colors">Startseite</a></li>
            <li><span class="text-stone-400 dark:text-gray-600">/</span></li>
            <li class="text-secondary">Sponsoren</li>
          </ol>
        </nav>
        <div class="inline-flex items-center gap-3 mb-6">
          <div class="w-12 h-px bg-secondary"></div>
          <span class="text-secondary font-bold text-sm uppercase tracking-[0.3em]">Danke an unsere Partner</span>
        </div>
        <h1 class="heading-xl text-stone-900 dark:text-white mb-6">
          Unsere <span class="text-secondary">Sponsoren</span>
        </h1>
        <p class="text-stone-600 dark:text-gray-400 text-xl max-w-2xl">
          Ohne unsere Partner wäre vieles nicht möglich. Wir bedanken uns bei allen,
          die den Verein und unseren Nachwuchs unterstützen.
        </p>
      </div>
    </section>

    <!-- Sponsoren -->
    <section class="section-padding bg-white dark:bg-gray-900">
      <div class="container-custom">
        {sponsoren.length === 0 ? (
          <div class="max-w-2xl mx-auto text-center reveal">
            <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-stone-100 dark:bg-gray-800 border border-stone-200 dark:border-gray-700 mb-8">
              <svg class="w-10 h-10 text-stone-400 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
            </div>
            <h2 class="text-stone-900 dark:text-white font-bold text-2xl mb-3">
              Sponsoren folgen in Kürze
            </h2>
            <p class="text-stone-600 dark:text-gray-400 text-base mb-8">
              Du möchtest unseren Verein und unseren Nachwuchs unterstützen?
              Schreib uns — wir freuen uns über jede Form von Förderung.
            </p>
            <a href="/kontakt" class="btn-primary text-sm">
              Sponsor werden
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </a>
          </div>
        ) : (
          <div class="space-y-20">
            {groupNames.map((group) => (
              <div>
                {groupNames.length > 1 && (
                  <div class="text-center mb-12 reveal">
                    <div class="inline-flex items-center gap-3">
                      <div class="w-12 h-px bg-accent"></div>
                      <h2 class="text-stone-900 dark:text-white font-bold text-2xl uppercase tracking-wider">{group}</h2>
                      <div class="w-12 h-px bg-accent"></div>
                    </div>
                  </div>
                )}
                <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
                  {grouped[group].map((s, index) => {
                    const inner = (
                      <div class="aspect-[3/2] flex items-center justify-center p-6 mb-4 bg-white dark:bg-stone-50 border border-stone-200 dark:border-gray-700 group-hover:border-secondary/60 shadow-sm group-hover:shadow-md transition-all duration-300">
                        {s.data.logo ? (
                          <img
                            src={s.data.logo}
                            alt={`${s.data.name} – Logo`}
                            class="max-w-full max-h-full object-contain filter grayscale group-hover:grayscale-0 transition-all duration-500"
                            loading="lazy"
                          />
                        ) : (
                          <span class="text-stone-700 dark:text-stone-700 font-display font-bold text-xl text-center">
                            {s.data.name}
                          </span>
                        )}
                      </div>
                    );
                    return (
                      <article
                        class="group reveal"
                        style={`transition-delay: ${index * 60}ms`}
                      >
                        {s.data.link ? (
                          <a href={s.data.link} target="_blank" rel="noopener" class="block" aria-label={`${s.data.name} (externer Link)`}>
                            {inner}
                          </a>
                        ) : inner}
                        <div class="text-center">
                          <h3 class="text-stone-900 dark:text-white font-bold text-base">{s.data.name}</h3>
                          {s.data.beschreibung && (
                            <p class="text-stone-600 dark:text-gray-400 text-xs mt-1">{s.data.beschreibung}</p>
                          )}
                        </div>
                      </article>
                    );
                  })}
                </div>
              </div>
            ))}

            <div class="text-center pt-8 border-t border-stone-200 dark:border-gray-800 reveal">
              <p class="text-stone-600 dark:text-gray-400 mb-6">
                Du möchtest auch Sponsor werden? Wir freuen uns auf dein Gespräch.
              </p>
              <a href="/kontakt" class="btn-secondary text-sm">
                Sponsor werden
              </a>
            </div>
          </div>
        )}
      </div>
    </section>

    <CTA />
  </main>
  <Footer />
</Layout>
