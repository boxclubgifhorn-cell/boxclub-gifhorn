---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getEntry, getCollection } from 'astro:content';

const entry = await getEntry('seite', 'satzung');
const { Content } = await entry!.render();
const { title, intro } = entry!.data;

const downloads = (await getCollection('download'))
  .sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);

// Optional: nach Kategorie gruppieren
const grouped = downloads.reduce((acc, d) => {
  const key = d.data.kategorie || 'Dokumente';
  if (!acc[key]) acc[key] = [];
  acc[key].push(d);
  return acc;
}, {} as Record<string, typeof downloads>);
const groupNames = Object.keys(grouped);

function fileIconPath(datei: string): string {
  const ext = (datei.split('.').pop() || '').toLowerCase();
  // Doc/PDF/generic icon path (heroicons document)
  return 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z';
}

const siteUrl = 'https://boxclub-gifhorn.de';
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Startseite', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Satzung & Downloads', item: `${siteUrl}/satzung` },
  ],
};
---

<Layout
  title={`${title} — Vereinsdokumente | Boxclub Gifhorn e.V.`}
  description="Vereinssatzung, Beitragsordnung und weitere Dokumente des Boxclub Gifhorn e.V. in Gifhorn zum Download."
  jsonLd={breadcrumb}
>
  <Header />
  <main id="main-content">
    <!-- Hero -->
    <section class="py-24 md:py-32 bg-stone-100 dark:bg-primary">
      <div class="container-custom">
        <nav class="mb-8" aria-label="Breadcrumb">
          <ol class="flex items-center gap-2 text-sm text-stone-500 dark:text-gray-500">
            <li><a href="/" class="hover:text-secondary transition-colors">Startseite</a></li>
            <li><span class="text-stone-400 dark:text-gray-600">/</span></li>
            <li class="text-secondary">Satzung & Downloads</li>
          </ol>
        </nav>
        <h1 class="heading-lg text-stone-900 dark:text-white mb-4">{title}</h1>
        {intro && (
          <p class="text-stone-600 dark:text-gray-400 text-lg max-w-2xl">{intro}</p>
        )}
        <div class="red-line mt-6"></div>
      </div>
    </section>

    <!-- Intro-Body -->
    <section class="py-16 md:py-20 bg-white dark:bg-gray-900">
      <div class="container-custom">
        <article class="legal-prose max-w-3xl">
          <Content />
        </article>

        <!-- Downloads-Liste -->
        <div class="max-w-3xl mt-12">
          {downloads.length === 0 ? (
            <div class="bg-stone-50 dark:bg-primary border border-stone-200 dark:border-gray-800 p-8 text-center">
              <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-stone-100 dark:bg-gray-800 border border-stone-200 dark:border-gray-700 mb-4">
                <svg class="w-8 h-8 text-stone-400 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
              </div>
              <h2 class="text-stone-900 dark:text-white font-bold text-xl mb-2">Dokumente folgen in Kürze</h2>
              <p class="text-stone-600 dark:text-gray-400 text-sm">
                Bei Bedarf an Vereinssatzung, Beitragsordnung oder Aufnahmeantrag
                melde dich bitte direkt beim Vorstand.
              </p>
              <a href="/kontakt" class="btn-secondary mt-6 text-sm">Kontakt aufnehmen</a>
            </div>
          ) : (
            <div class="space-y-12">
              {groupNames.map((group) => (
                <div>
                  {groupNames.length > 1 && (
                    <h2 class="text-stone-900 dark:text-white font-bold text-2xl mb-6">{group}</h2>
                  )}
                  <ul class="space-y-3">
                    {grouped[group].map((d) => (
                      <li>
                        <a
                          href={d.data.datei}
                          target="_blank"
                          rel="noopener"
                          class="group flex items-center gap-4 p-5 bg-stone-50 dark:bg-primary border border-stone-200 dark:border-gray-800 hover:border-secondary/50 shadow-sm dark:shadow-none hover:shadow-md transition-all duration-300"
                        >
                          <div class="w-12 h-12 flex-shrink-0 bg-secondary/10 border border-secondary/30 flex items-center justify-center group-hover:bg-secondary group-hover:border-secondary transition-colors duration-300">
                            <svg class="w-6 h-6 text-secondary group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={fileIconPath(d.data.datei)} />
                            </svg>
                          </div>
                          <div class="flex-1 min-w-0">
                            <p class="text-stone-900 dark:text-white font-bold group-hover:text-secondary transition-colors duration-300">
                              {d.data.titel}
                            </p>
                            {d.data.beschreibung && (
                              <p class="text-stone-600 dark:text-gray-400 text-sm mt-1">{d.data.beschreibung}</p>
                            )}
                            {d.data.stand && (
                              <p class="text-stone-500 dark:text-gray-500 text-xs mt-1">Stand: {d.data.stand}</p>
                            )}
                          </div>
                          <svg class="w-5 h-5 flex-shrink-0 text-stone-400 dark:text-gray-600 group-hover:text-secondary transform group-hover:translate-y-0.5 transition-all duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                          </svg>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
