---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTA from '../components/CTA.astro';
import FeiertageFerien from '../components/FeiertageFerien.astro';
import { getEntry } from 'astro:content';

const kursplan = await getEntry('kursplan', 'aktuell');
const data = kursplan?.data ?? {
  titel: 'Trainingsplan',
  beschreibung: '',
  bild: '',
  bild_alt: '',
  pdf: '',
  stand: '',
  hinweis: '',
  eintraege: [],
};

const hasBild = !!data.bild;
const hasPdf = !!data.pdf;

// Wochentage in feste Reihenfolge bringen
const WOCHENTAGE = ['Montag', 'Dienstag', 'Mittwoch', 'Donnerstag', 'Freitag', 'Samstag', 'Sonntag'] as const;
type Tag = typeof WOCHENTAGE[number];

const eintraege = data.eintraege || [];
const hasEintraege = eintraege.length > 0;

// Helper: parse Start-Zeit für Sortierung (z.B. "16:45–18:15" → 1645)
function startMinutes(zeit: string): number {
  const m = zeit.match(/^(\d{1,2})[:.;](\d{2})/);
  if (!m) return 9999;
  return parseInt(m[1], 10) * 60 + parseInt(m[2], 10);
}

// Gruppieren nach Tag, sortieren nach Zeit
const byTag = new Map<Tag, typeof eintraege>();
for (const t of WOCHENTAGE) byTag.set(t, []);
for (const e of eintraege) {
  const arr = byTag.get(e.tag as Tag);
  if (arr) arr.push(e);
}
for (const arr of byTag.values()) {
  arr.sort((a, b) => startMinutes(a.zeit) - startMinutes(b.zeit));
}

// Max Zeilen pro Tag (für Desktop-Tabelle)
const maxRowsPerDay = Math.max(...Array.from(byTag.values()).map(a => a.length), 0);

// Farben-Mapping für Badges
const farbeClass = (f: string) => {
  switch (f) {
    case 'orange': return 'border-l-secondary text-secondary';
    case 'gold':   return 'border-l-accent text-accent';
    case 'blau':   return 'border-l-blue-500 text-blue-600 dark:text-blue-400';
    case 'rot':    return 'border-l-red-600 text-red-600 dark:text-red-400';
    default:       return 'border-l-stone-300 dark:border-l-gray-600 text-stone-700 dark:text-gray-300';
  }
};

// ---- Filter-Kategorien (Reihenfolge = Anzeige-Reihenfolge der Chips) ----
const KATEGORIEN = [
  { key: 'boxen',     label: 'Boxen',     test: (k: string) => /boxen|fitness boxen/i.test(k) },
  { key: 'mma',       label: 'MMA',       test: (k: string) => /mma/i.test(k) },
  { key: 'judo',      label: 'Judo',      test: (k: string) => /judo/i.test(k) },
  { key: 'ringen',    label: 'Ringen',    test: (k: string) => /ringen/i.test(k) },
  { key: 'frauen',    label: 'Frauen',    test: (k: string) => /frauen/i.test(k) },
  { key: 'fitdance',  label: 'FitDance',  test: (k: string) => /fitdance/i.test(k) },
  { key: 'profis',    label: 'Profis',    test: (k: string) => /profis|fortgeschritten/i.test(k) },
];

// Kategorien pro Eintrag bestimmen (mehrere möglich)
function kategorienFuer(kurs: string): string[] {
  return KATEGORIEN.filter(c => c.test(kurs)).map(c => c.key);
}

// Nur Kategorien anzeigen, für die es mindestens einen Eintrag gibt
const vorhandeneKats = new Set<string>();
for (const e of eintraege) {
  for (const k of kategorienFuer(e.kurs)) vorhandeneKats.add(k);
}
const sichtbareKategorien = KATEGORIEN.filter(c => vorhandeneKats.has(c.key));

const siteUrl = 'https://boxclub-gifhorn.de';
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Startseite', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Kursplan', item: `${siteUrl}/kursplan` },
  ],
};
---

<Layout
  title={`${data.titel} — Trainingszeiten in Gifhorn | Boxclub Gifhorn e.V.`}
  description="Aktueller Trainingsplan des Boxclub Gifhorn e.V. — alle Kurse, Zeiten und Trainer in Gifhorn auf einen Blick: Boxen, MMA, Judo, Ringen, Frauenfitness."
  jsonLd={breadcrumb}
>
  <Header />
  <main id="main-content">
    <!-- Page Hero -->
    <section class="relative py-24 md:py-32 bg-stone-50 dark:bg-primary overflow-hidden">
      <div class="absolute inset-0 opacity-[0.07] dark:opacity-5 pointer-events-none">
        <div class="absolute inset-0 dark:hidden" style="background-image: radial-gradient(circle at 1px 1px, #0B0B0F 1px, transparent 0); background-size: 40px 40px;"></div>
        <div class="absolute inset-0 hidden dark:block" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;"></div>
      </div>

      <div class="container-custom relative z-10">
        <nav class="mb-8" aria-label="Breadcrumb">
          <ol class="flex items-center gap-2 text-sm text-stone-500 dark:text-gray-500">
            <li><a href="/" class="hover:text-secondary transition-colors">Startseite</a></li>
            <li><span class="text-stone-400 dark:text-gray-600">/</span></li>
            <li class="text-secondary">Kursplan</li>
          </ol>
        </nav>

        <div class="inline-flex items-center gap-3 mb-6">
          <div class="w-12 h-px bg-secondary"></div>
          <span class="text-secondary font-bold text-sm uppercase tracking-[0.3em]">Wochenübersicht</span>
        </div>
        <h1 class="heading-xl text-stone-900 dark:text-white mb-6">
          {data.titel}
        </h1>
        {data.beschreibung && (
          <p class="text-stone-600 dark:text-gray-400 text-xl max-w-2xl">
            {data.beschreibung}
          </p>
        )}
        {data.stand && (
          <p class="mt-6 inline-flex items-center gap-2 text-stone-500 dark:text-gray-500 text-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            Gültig ab {data.stand}
          </p>
        )}
      </div>
    </section>

    <!-- Plan-Inhalt -->
    <section class="section-padding bg-white dark:bg-gray-900">
      <div class="container-custom">

        {hasEintraege ? (
          <>
            {/* ===================== Filter-Chips ===================== */}
            <div id="kursfilter" class="mb-8 reveal" data-active="alle">
              <div class="flex items-center gap-3 mb-3">
                <svg class="w-4 h-4 text-stone-500 dark:text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 4h18M6 8h12M10 12h4M11 16h2" />
                </svg>
                <span class="text-stone-700 dark:text-gray-300 text-sm font-bold uppercase tracking-wider">Filter</span>
                <span class="text-stone-500 dark:text-gray-500 text-xs">— klick auf einen Kurs, alle anderen werden ausgeblendet</span>
              </div>
              <div class="flex flex-wrap gap-2" role="tablist" aria-label="Kurse filtern">
                <button
                  type="button"
                  class="kurs-chip is-active px-4 py-2 text-xs font-bold uppercase tracking-wider border-2 transition-all duration-200"
                  data-filter="alle"
                  role="tab"
                  aria-selected="true"
                >Alle Kurse</button>
                {sichtbareKategorien.map((cat) => (
                  <button
                    type="button"
                    class="kurs-chip px-4 py-2 text-xs font-bold uppercase tracking-wider border-2 transition-all duration-200"
                    data-filter={cat.key}
                    role="tab"
                    aria-selected="false"
                  >{cat.label}</button>
                ))}
              </div>
            </div>

            {/* ===================== Desktop: Tabelle ===================== */}
            <div class="hidden lg:block reveal">
              <div class="overflow-x-auto -mx-4 px-4">
                <table class="w-full border-collapse text-sm">
                  <thead>
                    <tr>
                      {WOCHENTAGE.map((tag) => (
                        <th class="px-3 py-3 text-left text-stone-900 dark:text-white font-display font-bold uppercase tracking-wider text-xs bg-stone-100 dark:bg-primary border-b-2 border-secondary">
                          {tag}
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {Array.from({ length: maxRowsPerDay }).map((_, rowIdx) => (
                      <tr class="border-b border-stone-200 dark:border-gray-800">
                        {WOCHENTAGE.map((tag) => {
                          const entry = byTag.get(tag)?.[rowIdx];
                          if (!entry) return <td class="kurs-cell px-3 py-3 align-top text-stone-300 dark:text-gray-700" data-kategorien="">—</td>;
                          const kats = kategorienFuer(entry.kurs).join(' ');
                          return (
                            <td class={`kurs-cell kurs-entry px-3 py-3 align-top border-l-4 transition-all duration-200 ${farbeClass(entry.farbe)} bg-stone-50/40 dark:bg-gray-800/30`} data-kategorien={kats}>
                              <div class="font-bold text-stone-900 dark:text-white text-sm">{entry.zeit}</div>
                              <div class="mt-0.5 font-semibold leading-tight">{entry.kurs}</div>
                              {entry.zielgruppe && (
                                <div class="mt-0.5 text-stone-600 dark:text-gray-400 text-xs">{entry.zielgruppe}</div>
                              )}
                              {entry.hinweis && (
                                <div class="mt-1 inline-block px-1.5 py-0.5 bg-accent/15 text-accent text-[10px] font-bold uppercase tracking-wider">
                                  {entry.hinweis}
                                </div>
                              )}
                            </td>
                          );
                        })}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>

            {/* ===================== Mobile/Tablet: Cards pro Tag ===================== */}
            <div class="lg:hidden space-y-4">
              {WOCHENTAGE.filter(t => (byTag.get(t)?.length || 0) > 0).map((tag) => (
                <div class="kurs-day-card bg-white dark:bg-gray-900 border border-stone-200 dark:border-gray-800 overflow-hidden reveal" data-tag-kategorien={byTag.get(tag)!.flatMap(e => kategorienFuer(e.kurs)).join(' ')}>
                  <div class="bg-stone-100 dark:bg-primary px-4 py-3 border-b-2 border-secondary">
                    <h3 class="text-stone-900 dark:text-white font-display font-bold uppercase tracking-wider">{tag}</h3>
                  </div>
                  <ul class="divide-y divide-stone-200 dark:divide-gray-800">
                    {byTag.get(tag)!.map((entry) => (
                      <li class={`kurs-entry px-4 py-3 border-l-4 transition-all duration-200 ${farbeClass(entry.farbe)}`} data-kategorien={kategorienFuer(entry.kurs).join(' ')}>
                        <div class="flex items-baseline gap-3">
                          <span class="font-bold text-stone-900 dark:text-white text-sm whitespace-nowrap">{entry.zeit}</span>
                          {entry.hinweis && (
                            <span class="inline-block px-1.5 py-0.5 bg-accent/15 text-accent text-[10px] font-bold uppercase tracking-wider">
                              {entry.hinweis}
                            </span>
                          )}
                        </div>
                        <div class="font-semibold text-stone-900 dark:text-white mt-1">{entry.kurs}</div>
                        {entry.zielgruppe && (
                          <div class="text-stone-600 dark:text-gray-400 text-xs mt-0.5">{entry.zielgruppe}</div>
                        )}
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>

            {/* Legende */}
            <div class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-xs text-stone-600 dark:text-gray-400 reveal">
              <span class="flex items-center gap-2"><span class="w-3 h-3 bg-secondary inline-block"></span> Boxen</span>
              <span class="flex items-center gap-2"><span class="w-3 h-3 bg-blue-500 inline-block"></span> Judo / Frauen</span>
              <span class="flex items-center gap-2"><span class="w-3 h-3 bg-accent inline-block"></span> FitDance / Highlight</span>
              <span class="flex items-center gap-2"><span class="w-3 h-3 bg-red-600 inline-block"></span> Kindertraining 5–8</span>
              <span class="flex items-center gap-2"><span class="w-3 h-3 bg-stone-400 inline-block"></span> Ringen / Profis</span>
            </div>
          </>
        ) : hasBild ? (
          <figure class="reveal">
            <div class="bg-stone-50 dark:bg-primary border border-stone-200 dark:border-gray-800 p-4 sm:p-6 shadow-lg dark:shadow-none">
              <a href={data.bild} target="_blank" rel="noopener" aria-label="Trainingsplan in voller Größe öffnen" class="block group">
                <img src={data.bild} alt={data.bild_alt || `${data.titel} — Wochenübersicht`} class="w-full h-auto transition-transform duration-500 group-hover:scale-[1.01]" loading="eager" />
              </a>
            </div>
            <figcaption class="mt-4 text-center text-sm text-stone-500 dark:text-gray-500">
              Tipp: Tippe auf das Bild für die volle Auflösung.
            </figcaption>
          </figure>
        ) : (
          <div class="max-w-2xl mx-auto text-center reveal">
            <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-stone-100 dark:bg-gray-800 border border-stone-200 dark:border-gray-700 mb-8">
              <svg class="w-10 h-10 text-stone-400 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
              </svg>
            </div>
            <h2 class="text-stone-900 dark:text-white font-bold text-2xl mb-3">
              Plan wird gerade aktualisiert
            </h2>
            <p class="text-stone-600 dark:text-gray-400 text-base mb-6">
              Den aktuellen Trainingsplan veröffentlichen wir hier in Kürze.
              In der Zwischenzeit findest du alle Kurse unter Leistungen — oder ruf uns einfach kurz an.
            </p>
            <div class="flex flex-wrap justify-center gap-4">
              <a href="/leistungen" class="btn-secondary text-sm">Zu den Kursen</a>
              <a href="tel:+4953717599679" class="btn-primary text-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                05371 7599679
              </a>
            </div>
          </div>
        )}

        {/* Download-Buttons (wenn Bild oder PDF vorhanden) */}
        {(hasBild || hasPdf) && (
          <div class="flex flex-wrap justify-center gap-4 mt-12 reveal">
            {hasBild && (
              <a href={data.bild} download class="btn-secondary text-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                Plan als Bild herunterladen
              </a>
            )}
            {hasPdf && (
              <a href={data.pdf} target="_blank" rel="noopener" class="btn-primary text-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                Plan als PDF
              </a>
            )}
          </div>
        )}

        {/* Hinweis */}
        {data.hinweis && (
          <aside class="mt-16 max-w-3xl mx-auto p-6 bg-stone-50 dark:bg-primary border-l-4 border-secondary reveal">
            <div class="flex gap-4">
              <svg class="w-6 h-6 text-secondary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <p class="text-stone-700 dark:text-gray-300 text-sm leading-relaxed">
                {data.hinweis}
              </p>
            </div>
          </aside>
        )}
      </div>
    </section>

    <FeiertageFerien />

    <CTA />
  </main>
  <Footer />
</Layout>

<style>
  /* Filter-Chips */
  .kurs-chip {
    border-color: rgb(214 211 209); /* stone-300 */
    color: rgb(68 64 60);            /* stone-700 */
    background: transparent;
  }
  :global(.dark) .kurs-chip {
    border-color: rgb(55 65 81);     /* gray-700 */
    color: rgb(209 213 219);         /* gray-300 */
  }
  .kurs-chip:hover {
    border-color: rgb(255 107 0);    /* secondary */
    color: rgb(255 107 0);
  }
  .kurs-chip.is-active {
    background: rgb(255 107 0);
    border-color: rgb(255 107 0);
    color: white;
  }

  /* Ausgegraute (nicht passende) Einträge */
  .kurs-entry.is-dimmed {
    opacity: 0.18;
    filter: grayscale(1);
    pointer-events: none;
  }
  /* Tag-Karte ohne passenden Eintrag (Mobile) */
  .kurs-day-card.is-hidden {
    display: none;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const root = document.getElementById('kursfilter');
    if (!root) return;
    const chips = root.querySelectorAll<HTMLButtonElement>('.kurs-chip');
    const entries = document.querySelectorAll<HTMLElement>('.kurs-entry');
    const dayCards = document.querySelectorAll<HTMLElement>('.kurs-day-card');

    function applyFilter(filter: string) {
      // Chips visuell
      chips.forEach((c) => {
        const isActive = c.dataset.filter === filter;
        c.classList.toggle('is-active', isActive);
        c.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      // Einträge dimmen
      entries.forEach((el) => {
        if (filter === 'alle') {
          el.classList.remove('is-dimmed');
          return;
        }
        const kats = (el.dataset.kategorien || '').split(/\s+/).filter(Boolean);
        const matches = kats.includes(filter);
        el.classList.toggle('is-dimmed', !matches);
      });

      // Mobile: Tag-Karte ganz ausblenden, wenn kein Treffer
      dayCards.forEach((card) => {
        if (filter === 'alle') {
          card.classList.remove('is-hidden');
          return;
        }
        const tagKats = (card.dataset.tagKategorien || '').split(/\s+/).filter(Boolean);
        card.classList.toggle('is-hidden', !tagKats.includes(filter));
      });

      root!.dataset.active = filter;
    }

    chips.forEach((chip) => {
      chip.addEventListener('click', () => applyFilter(chip.dataset.filter || 'alle'));
    });
  });
</script>
