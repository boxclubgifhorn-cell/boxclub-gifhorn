---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTA from '../components/CTA.astro';
import { getCollection } from 'astro:content';

const bilder = (await getCollection('galerie'))
  .sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);

const kategorien = Array.from(new Set(bilder.map(b => b.data.kategorie || 'Alle')));
const hasMultipleCats = kategorien.length > 1 && !(kategorien.length === 1 && kategorien[0] === 'Alle');

const siteUrl = 'https://boxclub-gifhorn.de';
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Startseite', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Galerie', item: `${siteUrl}/galerie` },
  ],
};
---

<Layout
  title="Galerie — Eindrücke aus dem Vereinsleben | Boxclub Gifhorn e.V."
  description="Bilder aus dem Boxclub Gifhorn e.V.: Training, Wettkämpfe und Vereinsleben in Gifhorn. Eindrücke vom Boxen, MMA, Judo und der Nachwuchsförderung."
  jsonLd={breadcrumb}
>
  <Header />
  <main id="main-content">
    <!-- Hero -->
    <section class="py-24 md:py-32 bg-stone-100 dark:bg-primary">
      <div class="container-custom">
        <nav class="mb-8" aria-label="Breadcrumb">
          <ol class="flex items-center gap-2 text-sm text-stone-500 dark:text-gray-500">
            <li><a href="/" class="hover:text-secondary transition-colors">Startseite</a></li>
            <li><span class="text-stone-400 dark:text-gray-600">/</span></li>
            <li class="text-secondary">Galerie</li>
          </ol>
        </nav>
        <div class="inline-flex items-center gap-3 mb-6">
          <div class="w-12 h-px bg-secondary"></div>
          <span class="text-secondary font-bold text-sm uppercase tracking-[0.3em]">Einblicke</span>
        </div>
        <h1 class="heading-xl text-stone-900 dark:text-white mb-6">
          Bilder aus dem <span class="text-secondary">Verein</span>
        </h1>
        <p class="text-stone-600 dark:text-gray-400 text-xl max-w-2xl">
          Training, Wettkämpfe, Events — hier findest du Eindrücke aus unserem Vereinsleben.
        </p>
      </div>
    </section>

    <!-- Galerie -->
    <section class="section-padding bg-white dark:bg-gray-900">
      <div class="container-custom">
        {bilder.length === 0 ? (
          <div class="max-w-2xl mx-auto text-center reveal">
            <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-stone-100 dark:bg-gray-800 border border-stone-200 dark:border-gray-700 mb-8">
              <svg class="w-10 h-10 text-stone-400 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <h2 class="text-stone-900 dark:text-white font-bold text-2xl mb-3">
              Bilder folgen in Kürze
            </h2>
            <p class="text-stone-600 dark:text-gray-400 text-base">
              Wir füllen die Galerie nach und nach mit Fotos vom Training, Wettkämpfen und
              Vereinsveranstaltungen. Bis dahin: Komm vorbei und mach dir selbst ein Bild.
            </p>
            <a href="/kursplan" class="btn-primary mt-8 text-sm">
              Trainingszeiten ansehen
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </a>
          </div>
        ) : (
          <>
            {hasMultipleCats && (
              <div class="flex flex-wrap justify-center gap-3 mb-12 reveal" role="tablist">
                <button
                  type="button"
                  data-filter="*"
                  class="gallery-filter px-5 py-2 text-sm font-bold uppercase tracking-wider border border-stone-300 dark:border-gray-700 bg-secondary text-white"
                >
                  Alle
                </button>
                {kategorien.map((k) => (
                  <button
                    type="button"
                    data-filter={k}
                    class="gallery-filter px-5 py-2 text-sm font-bold uppercase tracking-wider border border-stone-300 dark:border-gray-700 text-stone-700 dark:text-gray-300 hover:bg-stone-100 dark:hover:bg-gray-800 transition-colors"
                  >
                    {k}
                  </button>
                ))}
              </div>
            )}

            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 md:gap-4" id="gallery-grid">
              {bilder.map((b, index) => (
                <button
                  type="button"
                  class="gallery-item group relative overflow-hidden aspect-square bg-stone-100 dark:bg-gray-800 reveal"
                  data-kategorie={b.data.kategorie || 'Alle'}
                  data-fullsrc={b.data.bild}
                  data-alt={b.data.bild_alt || b.data.titel}
                  data-titel={b.data.titel}
                  aria-label={`${b.data.titel} – in voller Größe öffnen`}
                  style={`transition-delay: ${index * 40}ms`}
                >
                  <img
                    src={b.data.bild}
                    alt={b.data.bild_alt || b.data.titel}
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/0 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                  <div class="absolute bottom-0 left-0 right-0 p-4 text-left opacity-0 group-hover:opacity-100 translate-y-2 group-hover:translate-y-0 transition-all duration-300">
                    <p class="text-white text-sm font-bold">{b.data.titel}</p>
                    {b.data.datum && (
                      <p class="text-gray-300 text-xs mt-0.5">{b.data.datum}</p>
                    )}
                  </div>
                </button>
              ))}
            </div>
          </>
        )}
      </div>
    </section>

    <CTA />
  </main>
  <Footer />

  <!-- Lightbox -->
  <div
    id="lightbox"
    class="fixed inset-0 z-[100] bg-black/95 hidden items-center justify-center p-4 md:p-8"
    role="dialog"
    aria-modal="true"
    aria-label="Bild-Vergrößerung"
  >
    <button
      type="button"
      id="lightbox-close"
      class="absolute top-4 right-4 md:top-6 md:right-6 w-12 h-12 flex items-center justify-center text-white hover:text-secondary transition-colors"
      aria-label="Schließen"
    >
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <figure class="max-w-7xl max-h-full w-full flex flex-col items-center">
      <img id="lightbox-img" src="" alt="" class="max-w-full max-h-[85vh] object-contain" />
      <figcaption id="lightbox-caption" class="mt-4 text-white text-sm text-center"></figcaption>
    </figure>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Filter
      const filterButtons = document.querySelectorAll<HTMLButtonElement>('.gallery-filter');
      const items = document.querySelectorAll<HTMLElement>('.gallery-item');

      filterButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const f = btn.dataset.filter;
          filterButtons.forEach((b) => {
            b.classList.remove('bg-secondary', 'text-white');
            b.classList.add('text-stone-700', 'dark:text-gray-300');
          });
          btn.classList.add('bg-secondary', 'text-white');
          btn.classList.remove('text-stone-700', 'dark:text-gray-300');

          items.forEach((item) => {
            const k = item.dataset.kategorie;
            (item as HTMLElement).style.display = (f === '*' || f === k) ? '' : 'none';
          });
        });
      });

      // Lightbox
      const lightbox = document.getElementById('lightbox')!;
      const lbImg = document.getElementById('lightbox-img') as HTMLImageElement;
      const lbCaption = document.getElementById('lightbox-caption')!;
      const lbClose = document.getElementById('lightbox-close')!;

      const open = (src: string, alt: string, titel: string) => {
        lbImg.src = src;
        lbImg.alt = alt;
        lbCaption.textContent = titel;
        lightbox.classList.remove('hidden');
        lightbox.classList.add('flex');
        document.body.style.overflow = 'hidden';
      };
      const close = () => {
        lightbox.classList.add('hidden');
        lightbox.classList.remove('flex');
        document.body.style.overflow = '';
      };

      items.forEach((item) => {
        item.addEventListener('click', () => {
          open(item.dataset.fullsrc || '', item.dataset.alt || '', item.dataset.titel || '');
        });
      });
      lbClose.addEventListener('click', close);
      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) close();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !lightbox.classList.contains('hidden')) close();
      });
    });
  </script>
</Layout>
