---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTA from '../../components/CTA.astro';
import { getCollection } from 'astro:content';

const allNews = (await getCollection('news', ({ data }) => data.veroeffentlicht !== false))
  .sort((a, b) => b.data.datum.valueOf() - a.data.datum.valueOf());

function formatDate(d: Date): string {
  return d.toLocaleDateString('de-DE', { day: '2-digit', month: 'long', year: 'numeric' });
}

const siteUrl = 'https://boxclub-gifhorn.de';
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Startseite', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'News', item: `${siteUrl}/news` },
  ],
};
---

<Layout
  title="News & Wettkampfergebnisse aus Gifhorn | Boxclub Gifhorn e.V."
  description="Aktuelle Neuigkeiten, Wettkampfergebnisse und Vereinsmeldungen vom Boxclub Gifhorn e.V. — Boxen, MMA, Judo und Ringen in Gifhorn."
  jsonLd={breadcrumb}
>
  <Header />
  <main id="main-content">
    <!-- Hero -->
    <section class="py-24 md:py-32 bg-stone-100 dark:bg-primary">
      <div class="container-custom">
        <nav class="mb-8" aria-label="Breadcrumb">
          <ol class="flex items-center gap-2 text-sm text-stone-500 dark:text-gray-500">
            <li><a href="/" class="hover:text-secondary transition-colors">Startseite</a></li>
            <li><span class="text-stone-400 dark:text-gray-600">/</span></li>
            <li class="text-secondary">News</li>
          </ol>
        </nav>
        <div class="inline-flex items-center gap-3 mb-6">
          <div class="w-12 h-px bg-secondary"></div>
          <span class="text-secondary font-bold text-sm uppercase tracking-[0.3em]">Aktuelles</span>
        </div>
        <h1 class="heading-xl text-stone-900 dark:text-white mb-6">
          <span class="text-secondary">News</span> aus dem Verein
        </h1>
        <p class="text-stone-600 dark:text-gray-400 text-xl max-w-2xl">
          Wettkampfergebnisse, Veranstaltungen und Vereinsmeldungen — alles auf einen Blick.
        </p>
      </div>
    </section>

    <!-- News-Liste -->
    <section class="section-padding bg-white dark:bg-gray-900">
      <div class="container-custom">
        {allNews.length === 0 ? (
          <div class="max-w-2xl mx-auto text-center reveal">
            <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-stone-100 dark:bg-gray-800 border border-stone-200 dark:border-gray-700 mb-8">
              <svg class="w-10 h-10 text-stone-400 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
              </svg>
            </div>
            <h2 class="text-stone-900 dark:text-white font-bold text-2xl mb-3">
              Bald gibt es Neuigkeiten
            </h2>
            <p class="text-stone-600 dark:text-gray-400 text-base">
              Wir veröffentlichen hier Wettkampfergebnisse, Termine und Vereinsmeldungen.
              Schau bald wieder rein — oder folge uns über Social Media.
            </p>
          </div>
        ) : (
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            {allNews.map((post, index) => (
              <article
                class="group reveal"
                style={`transition-delay: ${index * 80}ms`}
              >
                <a href={`/news/${post.slug}`} class="block">
                  <div class="aspect-[16/10] overflow-hidden bg-stone-100 dark:bg-gray-800 mb-5">
                    {post.data.bild ? (
                      <img
                        src={post.data.bild}
                        alt={post.data.bild_alt || post.data.titel}
                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                        loading="lazy"
                      />
                    ) : (
                      <div class="w-full h-full flex items-center justify-center">
                        <svg class="w-16 h-16 text-stone-300 dark:text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                      </div>
                    )}
                  </div>
                  <div class="flex items-center gap-3 text-xs text-stone-500 dark:text-gray-500 mb-2">
                    <time datetime={post.data.datum.toISOString()}>{formatDate(post.data.datum)}</time>
                    {post.data.kategorie && (
                      <>
                        <span>·</span>
                        <span class="text-secondary font-bold uppercase tracking-wider">{post.data.kategorie}</span>
                      </>
                    )}
                  </div>
                  <h2 class="text-stone-900 dark:text-white font-bold text-xl mb-3 group-hover:text-secondary transition-colors duration-300">
                    {post.data.titel}
                  </h2>
                  {post.data.teaser && (
                    <p class="text-stone-600 dark:text-gray-400 text-sm leading-relaxed">
                      {post.data.teaser}
                    </p>
                  )}
                  <div class="mt-4 inline-flex items-center gap-2 text-secondary text-sm font-bold uppercase tracking-wider">
                    Weiterlesen
                    <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                    </svg>
                  </div>
                </a>
              </article>
            ))}
          </div>
        )}
      </div>
    </section>

    <CTA />
  </main>
  <Footer />
</Layout>
