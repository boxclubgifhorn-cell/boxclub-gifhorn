---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTA from '../../components/CTA.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const all = await getCollection('news', ({ data }) => data.veroeffentlicht !== false);
  return all.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

function formatDate(d: Date): string {
  return d.toLocaleDateString('de-DE', { day: '2-digit', month: 'long', year: 'numeric' });
}

const siteUrl = 'https://boxclub-gifhorn.de';
const orgId = `${siteUrl}/#organization`;
const articleUrl = `${siteUrl}/news/${entry.slug}`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Startseite', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: 'News', item: `${siteUrl}/news` },
      { '@type': 'ListItem', position: 3, name: entry.data.titel, item: articleUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'NewsArticle',
    headline: entry.data.titel,
    description: entry.data.teaser || entry.data.titel,
    datePublished: entry.data.datum.toISOString(),
    inLanguage: 'de-DE',
    url: articleUrl,
    image: entry.data.bild ? [entry.data.bild] : undefined,
    author: entry.data.autor
      ? { '@type': 'Person', name: entry.data.autor }
      : { '@id': orgId },
    publisher: { '@id': orgId },
    mainEntityOfPage: articleUrl,
    articleSection: entry.data.kategorie,
  },
];
---

<Layout
  title={`${entry.data.titel} | News — Boxclub Gifhorn e.V.`}
  description={entry.data.teaser || `${entry.data.titel} – Aktuelles vom Boxclub Gifhorn e.V.`}
  ogImage={entry.data.bild}
  jsonLd={jsonLd}
>
  <Header />
  <main id="main-content">
    <!-- Hero -->
    <section class="py-24 md:py-32 bg-stone-100 dark:bg-primary">
      <div class="container-custom">
        <nav class="mb-8" aria-label="Breadcrumb">
          <ol class="flex items-center gap-2 text-sm text-stone-500 dark:text-gray-500">
            <li><a href="/" class="hover:text-secondary transition-colors">Startseite</a></li>
            <li><span class="text-stone-400 dark:text-gray-600">/</span></li>
            <li><a href="/news" class="hover:text-secondary transition-colors">News</a></li>
            <li><span class="text-stone-400 dark:text-gray-600">/</span></li>
            <li class="text-secondary truncate max-w-[40ch]">{entry.data.titel}</li>
          </ol>
        </nav>

        <div class="flex items-center gap-3 text-xs text-stone-600 dark:text-gray-400 mb-4">
          <time datetime={entry.data.datum.toISOString()} class="font-bold uppercase tracking-wider">
            {formatDate(entry.data.datum)}
          </time>
          {entry.data.kategorie && (
            <>
              <span>·</span>
              <span class="text-secondary font-bold uppercase tracking-wider">{entry.data.kategorie}</span>
            </>
          )}
          {entry.data.autor && (
            <>
              <span>·</span>
              <span>von {entry.data.autor}</span>
            </>
          )}
        </div>

        <h1 class="heading-lg text-stone-900 dark:text-white mb-4 max-w-4xl">
          {entry.data.titel}
        </h1>
        {entry.data.teaser && (
          <p class="text-stone-600 dark:text-gray-400 text-lg max-w-2xl">
            {entry.data.teaser}
          </p>
        )}
        <div class="red-line mt-6"></div>
      </div>
    </section>

    {entry.data.bild && (
      <div class="bg-white dark:bg-gray-900 pt-12">
        <div class="container-custom">
          <figure class="max-w-4xl mx-auto">
            <img
              src={entry.data.bild}
              alt={entry.data.bild_alt || entry.data.titel}
              class="w-full h-auto"
              loading="eager"
            />
          </figure>
        </div>
      </div>
    )}

    <!-- Body -->
    <section class="section-padding bg-white dark:bg-gray-900">
      <div class="container-custom">
        <article class="legal-prose max-w-3xl mx-auto">
          <Content />
        </article>

        <div class="max-w-3xl mx-auto mt-16 pt-8 border-t border-stone-200 dark:border-gray-800 flex flex-wrap items-center justify-between gap-4">
          <a href="/news" class="inline-flex items-center gap-2 text-secondary font-bold text-sm uppercase tracking-wider hover:underline">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Zurück zur Übersicht
          </a>
          <a href="/kontakt" class="btn-secondary text-sm">Kontakt aufnehmen</a>
        </div>
      </div>
    </section>

    <CTA />
  </main>
  <Footer />
</Layout>
